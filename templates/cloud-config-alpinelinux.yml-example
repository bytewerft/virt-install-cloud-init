#cloud-config
# When using static ip configuration net-config does not create a resolv.conf
# https://gitlab.alpinelinux.org/alpine/cloud/alpine-cloud-images/-/work_items/168
# Workaround is to create resolv.conf here
#manage_resolv_conf: true
#resolv_conf:
#  nameservers: [8.8.8.8, 8.8.4.4]
package_upgrade: true
package_update: true
packages:
  - sudo
  - qemu-guest-agent
runcmd:
  - sed -i -e 's/timeout=10/timeout=1/g' /etc/update-extlinux.conf && update-extlinux
  - rc-update add qemu-guest-agent
  - [ sh, -c, 'echo "network: {config: disabled}" > /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg' ]
users:
  - name: cloud
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    # Create a password: mkpasswd -m sha512crypt -s
    passwd: $6$ATDaGC12699/EXd3$U9WcFlrGSi/4a7Z6qXRPsmuObfrACAwjKhQsHJsvIdzrHlTgFcCb9fq/uPd8olGPebDOt3YgNmeJUWN7BrcmX.
    ssh_authorized_keys:
      - ssh-ed25519 <redacted>
power_state:
  mode: poweroff
  timeout: 30
  condition: True
write_files:
  - path: /etc/motd
    content: |+

      Welcome to Alpine!

      The Alpine Wiki contains a large amount of how-to guides and general
      information about administrating Alpine systems.
      See <https://wiki.alpinelinux.org>.

      Alpine release notes:
      * <https://alpinelinux.org/posts/Alpine-3.20.10-3.21.7-3.22.4-3.23.4-released.html>

    defer: false